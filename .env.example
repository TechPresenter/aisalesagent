# Copy to .env and adjust. The values below match docker-compose.yml as shipped, so on a
# fresh clone `cp .env.example .env` is enough to get `npm run dev` talking to the
# containers with no edits.

# --- apps/api ---------------------------------------------------------------
DATABASE_URL="postgresql://appsgain:appsgain@localhost:5432/appsgain?schema=public"
# The integration tests point at the second container (port 5433) so a test run can
# truncate every table without destroying development data.
TEST_DATABASE_URL="postgresql://appsgain:appsgain@localhost:5433/appsgain_test?schema=public"

REDIS_URL="redis://localhost:6379"

API_PORT=4000
# Comma-separated list; the web app's origin must be here or the browser blocks it.
# 3001 is where .claude/launch.json runs the web preview, so both work out of the box.
API_CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Generate real secrets before deploying anywhere: `openssl rand -base64 48`.
# Access and refresh tokens are signed with *different* secrets on purpose, so a leaked
# access-token secret cannot be used to mint refresh tokens.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
# Encrypts third-party provider credentials at rest (AES-256-GCM). Must be at least
# 32 characters; changing it makes every stored credential undecryptable, so rotate
# deliberately. Generate with: openssl rand -base64 48
CREDENTIALS_ENCRYPTION_KEY="dev-credentials-key-change-me-at-least-32-chars"

JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- platform email ----------------------------------------------------------
# Password resets, email verification codes, team invitations and security notices.
# "log" (the default outside production) writes each email to the API log instead of
# sending it, so the flows can be followed locally. Production needs a real provider:
# MAIL_DRIVER="sendgrid" or "resend", with MAIL_API_KEY and a verified MAIL_FROM.
MAIL_DRIVER="log"
MAIL_API_KEY=""
MAIL_FROM=""
MAIL_FROM_NAME="Appsgain"

# --- integrations ----------------------------------------------------------
# Public addresses, used for OAuth redirect URIs and for the links inside webhook
# payloads, chat messages and notification emails. Set both to the deployed URLs.
API_PUBLIC_URL="http://localhost:4000"
WEB_APP_URL="http://localhost:3000"
# OAuth apps for the integrations that connect by signing in (Google Calendar, Outlook,
# Salesforce). Register <API_PUBLIC_URL>/api/integrations/oauth/callback as the redirect
# URI with each vendor. Left blank, those integrations show as needing setup.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""
SALESFORCE_OAUTH_CLIENT_ID=""
SALESFORCE_OAUTH_CLIENT_SECRET=""
# Webhooks may target private network addresses outside production only. Set to true to
# allow them in production as well, e.g. when every receiver is on an internal network.
# WEBHOOKS_ALLOW_PRIVATE_NETWORK="false"

# --- deployment (Vercel) ------------------------------------------------------
# Not needed locally. The per-environment values live in deploy/vercel/*.env.example and
# docs/deployment.md explains them.
#   CRON_SECRET            lets the scheduler run the integrations worker through
#                          /api/internal/cron/integrations. Locally the worker keeps its own
#                          30-second timer; INTEGRATIONS_WORKER="off" stops it.
#   DATABASE_URL_UNPOOLED  the direct database connection the Vercel build migrates with.
#   ACCESS_GATE_USERNAME, ACCESS_GATE_PASSWORD
#                          (web) the password prompt in front of DEV, QA and UAT.

# --- apps/ai-service --------------------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_CORS_ORIGINS="http://localhost:3000,http://localhost:4000"
# Shared secret the NestJS API presents when calling the AI service.
AI_SERVICE_API_KEY="dev-ai-service-key-change-me"

# --- apps/web ---------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
