# Environment variables for the web app's Vercel project (Root Directory: apps/web).
#
# Paste one copy per environment into Vercel → web project → Settings → Environment
# Variables, with the same environment and branch mapping as api.env.example:
#   LIVE → "Production"; UAT, QA, DEV → "Preview" with Git branch uat, qa, develop.
# NEXT_PUBLIC_ values are built into the pages, so a change needs a new deployment.

# The API for this environment:
#   DEV https://api-dev.appsgain.app   QA  https://api-qa.appsgain.app
#   UAT https://api-uat.appsgain.app   LIVE https://api.appsgain.app
NEXT_PUBLIC_API_URL="https://api-qa.appsgain.app"

# The password gate. Set both on DEV, QA and UAT, with a different password for each;
# leave both unset on LIVE, which is public. Share each password only with the people who
# use that environment.
ACCESS_GATE_USERNAME="appsgain-qa"
ACCESS_GATE_PASSWORD="<unique, from: openssl rand -base64 18>"

# "Continue with Google / Microsoft" (Clerk). The publishable key of the same Clerk
# application whose secret key the API project has as CLERK_SECRET_KEY. Unset, the two
# buttons stay disabled and Clerk is never loaded. Until there is a domain DEV, QA and UAT
# use the development instance (pk_test_...); leave it off LIVE until a production instance
# (pk_live_...) exists, which drops in with no code change. This project's exact address must
# also be in the API's API_CORS_ORIGINS, or the API refuses the sign-in. docs/deployment.md
# explains why and has the steps.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="<Clerk publishable key>"

# Product contact and pricing, shown in the app (all optional; NEXT_PUBLIC_, so built in at
# deploy time). The support email and phone become the plans page's Talk to Sales and
# Contact Us links, and the email is where workspace-deletion requests go; unset, those
# links are left out.
# The tax note is the line under the prices; unset, it says only that prices are in rupees
# and taxes apply. e.g. "Prices exclude 18% GST."
# NEXT_PUBLIC_SUPPORT_EMAIL=""
# NEXT_PUBLIC_SUPPORT_PHONE=""
# NEXT_PUBLIC_PRICE_TAX_NOTE=""
# Find Leads (AI) is a preview over sample data until a licensed data source exists. Off
# by default: the menu leaves it out and the route says "coming soon". "true" shows it.
# NEXT_PUBLIC_FEATURE_FIND_LEADS=""
