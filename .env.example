# Copy to .env and adjust. The values below match docker-compose.yml as shipped, so on a
# fresh clone `cp .env.example .env` is enough to get `npm run dev` talking to the
# containers with no edits.

# --- apps/api ---------------------------------------------------------------
DATABASE_URL="postgresql://appsgain:appsgain@localhost:5432/appsgain?schema=public"
# The integration tests point at the second container (port 5433) so a test run can
# truncate every table without destroying development data.
TEST_DATABASE_URL="postgresql://appsgain:appsgain@localhost:5433/appsgain_test?schema=public"

REDIS_URL="redis://localhost:6379"

API_PORT=4000
# Comma-separated list; the web app's origin must be here or the browser blocks it.
API_CORS_ORIGINS="http://localhost:3000"

# Generate real secrets before deploying anywhere: `openssl rand -base64 48`.
# Access and refresh tokens are signed with *different* secrets on purpose, so a leaked
# access-token secret cannot be used to mint refresh tokens.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
# Encrypts third-party provider credentials at rest (AES-256-GCM). Must be at least
# 32 characters; changing it makes every stored credential undecryptable, so rotate
# deliberately. Generate with: openssl rand -base64 48
CREDENTIALS_ENCRYPTION_KEY="dev-credentials-key-change-me-at-least-32-chars"

JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- apps/ai-service --------------------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_CORS_ORIGINS="http://localhost:3000,http://localhost:4000"
# Shared secret the NestJS API presents when calling the AI service.
AI_SERVICE_API_KEY="dev-ai-service-key-change-me"

# --- apps/web ---------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
