# Environment variables for the API's Vercel project (Root Directory: apps/api).
#
# Fill in one copy per environment and paste it into Vercel → API project → Settings →
# Environment Variables:
#   LIVE → environment "Production"
#   UAT  → environment "Preview", Git branch "uat"
#   QA   → environment "Preview", Git branch "qa"
#   DEV  → environment "Preview", Git branch "develop"
# Every value marked <unique> must differ between environments, so a secret leaked from
# a test environment opens nothing on LIVE. Generate each with: openssl rand -base64 48
# Changing a variable takes effect on the next deployment of that branch.
# docs/deployment.md explains each step.

# --- database (Neon: this environment's branch) ------------------------------------------
# Pooled connection (host contains "-pooler"), used by the running API.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Direct connection, used only by the build step to run migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# --- secrets <unique> ---------------------------------------------------------------------
JWT_ACCESS_SECRET="<unique>"
JWT_REFRESH_SECRET="<unique, different from JWT_ACCESS_SECRET>"
# Encrypts stored integration credentials and 2FA secrets. Never change it once the
# environment holds data: everything encrypted with the old value becomes unreadable.
CREDENTIALS_ENCRYPTION_KEY="<unique>"
# Protects /api/internal/cron/integrations. The "Background jobs" GitHub workflow sends it in
# every environment (store it there as DEV_, QA_, UAT_ or LIVE_CRON_SECRET), and Vercel Cron
# sends it on LIVE.
CRON_SECRET="<unique>"

# --- addresses (DEV / QA / UAT / LIVE) --------------------------------------------------
# DEV:  https://dev.appsgain.app   QA: https://qa.appsgain.app
# UAT:  https://uat.appsgain.app   LIVE: https://app.appsgain.app
WEB_APP_URL="https://qa.appsgain.app"
# The web app's address; on LIVE also add https://www.appsgain.app if www serves the app.
API_CORS_ORIGINS="https://qa.appsgain.app"
# This API's own address: https://api-dev / api-qa / api-uat .appsgain.app, or https://api.appsgain.app
API_PUBLIC_URL="https://api-qa.appsgain.app"

# --- platform email ---------------------------------------------------------------------
# Needed in every environment: on Vercel the API runs in production mode everywhere, so
# the development "log" driver is refused and resets, verification codes and invitations
# go nowhere without a provider. Use a separate sender or API key for DEV and QA.
MAIL_DRIVER="resend"
MAIL_API_KEY="<provider API key>"
MAIL_FROM="no-reply@appsgain.app"
MAIL_FROM_NAME="Appsgain"

# --- Google and Microsoft sign-in (Clerk) -------------------------------------------------
# The secret key of the Clerk application whose publishable key the web project has. Unset,
# the sign-in buttons stay off and /api/auth/sso/* answers 503. Tokens are only accepted
# from the origins in API_CORS_ORIGINS and WEB_APP_URL. Until there is a domain, DEV, QA and
# UAT use the development instance (sk_test_...); leave it off LIVE until a production
# instance (sk_live_...) exists, which drops in with no code change. docs/deployment.md
# explains why and has the steps.
CLERK_SECRET_KEY="<Clerk secret key>"
# Optional: Clerk dashboard → API keys → PEM public key, to verify tokens without a network call.
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----..."

# --- optional ---------------------------------------------------------------------------
# JWT_ACCESS_TTL="15m"
# JWT_REFRESH_TTL="7d"
# OAuth apps for Google Calendar, Outlook and Salesforce. Register
# <API_PUBLIC_URL>/api/integrations/oauth/callback as the redirect URI with each vendor.
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""
# MICROSOFT_OAUTH_CLIENT_ID=""
# MICROSOFT_OAUTH_CLIENT_SECRET=""
# SALESFORCE_OAUTH_CLIENT_ID=""
# SALESFORCE_OAUTH_CLIENT_SECRET=""
# Build without running migrations (for example while restoring a database):
# SKIP_DB_MIGRATIONS="1"
